<!-- 搜索栏容器 -->
<view class="search-container">
  <input 
    class="search-input" 
    placeholder="输入古诗文关键词..." 
    bindinput="onInput" 
    value="{{searchKeyword}}"
    bindconfirm="doSearch"
  />
  <view class="search-btn" bindtap="doSearch">搜索</view>
</view>

<!-- 书籍列表部分 -->
<view class="books-outer-container">
  <!-- 添加显示全部按钮 -->
  <view class="show-all-btn" bindtap="navigateToAllBooks">
    <text>显示全部</text>
    <image src="https://newlan.oss-cn-shanghai.aliyuncs.com/icons/right-arrow.png" class="arrow-icon" />
  </view>
  
  <view class="page-title">群籍藏识</view>
  
  <!-- 加载状态 -->
  <view wx:if="{{loadingBooks}}" class="loading-container">
    <text>加载中...</text>
  </view>

  <!-- 错误提示 -->
  <view wx:if="{{booksError}}" class="error-container">
    <text>{{booksError}}</text>
  </view>

  <!-- 轮播图容器 -->
  <swiper 
    class="book-swiper-container"
    autoplay="{{true}}"
    interval="5000"
    circular="{{true}}"
    display-multiple-items="{{3}}"
    previous-margin="30rpx"
    next-margin="30rpx"
    bindchange="onSwiperChange"
    current="{{currentBookIndex}}"
  >
    <block wx:for="{{ancientTexts}}" wx:key="id">
      <swiper-item>
        <view 
          class="book-item"
          bindtap="navigateToBookDetail" 
          data-index="{{index}}"
        >
          <!-- 图片区域 - 优化容器 -->
          <view class="image-container">
            <image 
              src="{{item.safeImage}}" 
              mode="aspectFit" 
              class="book-image"
              data-index="{{index}}"
              binderror="handleBookImageError"
              bindload="handleBookImageLoad"
            />
            
            <!-- 图片加载状态 -->
            <view wx:if="{{!item.imageLoaded && !item.imageError}}" class="image-loading">
              <text>加载中...</text>
            </view>
            
            <!-- 错误提示 -->
            <view wx:if="{{item.imageError}}" class="image-error">
              <text>图片加载失败</text>
            </view>
            
            <!-- 书名覆盖在图片上 -->
            <view class="book-title-overlay">
              <text class="title-text">{{item.title}}</text>
            </view>
          </view>
        </view>
      </swiper-item>
    </block>
  </swiper>
</view>

<!-- 滚动指示器 -->
<view wx:if="{{ancientTexts.length > 1}}" class="scroll-indicator">
  <view 
    wx:for="{{ancientTexts}}" 
    wx:key="id" 
    class="indicator-dot {{index === currentBookIndex ? 'active' : ''}}"
    bindtap="scrollToBook"
    data-index="{{index}}"
  ></view>
</view>

<!-- 文章列表部分 -->
<scroll-view 
  class="result-list" 
  scroll-y="true"
  scroll-with-animation="true"
  enable-back-to-top="true"
>
  <!-- 顶部占位符 - 确保内容从搜索栏下方开始 -->
  <view class="top-spacer"></view>
  
  <block wx:if="{{!loadingArticles}}">
    <block wx:if="{{totalCount === 0}}">
      <view class="empty-result">
        <view class="empty-text">
          {{hasSearched ? '没有找到匹配的古诗文' : '暂无古诗文数据'}}
        </view>
        <view class="empty-tip">
          {{hasSearched ? '请尝试不同的关键词' : ''}}
        </view>
      </view>
    </block>
    
    <block wx:else>
      <view class="search-header">
        <view class="result-count">
          {{hasSearched ? '找到 ' + totalCount + ' 条匹配结果' : '共 ' + totalCount + ' 条'}}
        </view>
      </view>
      
      <block wx:for="{{searchResults}}" wx:key="id">
        <view 
          class="result-card" 
          bindtap="navigateToArticleDetail"
          data-item="{{item}}"  
          data-id="{{item.id}}" 
          data-index="{{index}}" 
        >
          <text class="title">{{item.title}}</text>
          <view class="info-row">
            <text class="author">{{item.author || '未知'}}</text>
            <text class="dynasty">{{item.dynasty || '不详'}}</text>
          </view>
          <text class="content">{{item.content || item.description}}</text>
        </view>
      </block>
    </block>
  </block>
  
  <!-- 加载状态 -->
  <view class="loading" wx:if="{{loadingArticles}}">
    <text>加载中...</text>
  </view>
  
  <!-- 底部占位符 - 确保内容不被分页栏遮挡 -->
  <view class="bottom-spacer"></view>
</scroll-view>

<!-- 固定在底部的分页栏 - 只控制文章列表 -->
<view class="pagination-container" wx:if="{{totalCount > 0 && searchResults.length > 0}}">
  <text class="total-count">总计 {{totalCount}}</text>
  
  <view class="pagination-controls">
    <!-- 左箭头 -->
    <view 
      class="pagination-arrow {{currentPage === 1 ? 'disabled' : ''}}" 
      bindtap="goToPrevPage"
    >
      <image src="https://newlan.oss-cn-shanghai.aliyuncs.com/icons/%E5%B7%A6%E7%AE%AD%E5%A4%B4.jpg" class="arrow-icon" mode="aspectFit" />
    </view>
    
    <!-- 当前页码显示 -->
    <view class="page-current-container">
      <text>{{currentPage}}</text>
    </view>
    
    <!-- 右箭头 -->
    <view 
      class="pagination-arrow {{currentPage === totalPages ? 'disabled' : ''}}" 
      bindtap="goToNextPage"
    >
      <image src="https://newlan.oss-cn-shanghai.aliyuncs.com/icons/%E5%8F%B3%E7%AE%AD%E5%A4%B4.jpg" class="arrow-icon" mode="aspectFit" />
    </view>
    
    <!-- 转到区域 -->
    <view class="goto-group">
      <text class="goto-label">转到</text>
      <input 
        class="goto-input" 
        type="number" 
        placeholder="页码" 
        value="{{gotoPage}}"
        bindinput="onGotoInput"
      />
    </view>
    
    <!-- 跳转按钮 -->
    <button class="goto-button" bindtap="goToSpecifiedPage">跳转</button>
  </view>
</view>

<!-- 浮动导航按钮 -->
<view class="float-nav-tool" bindtap="navigateToIndex">
  <text class="float-nav-icon">🏠</text>
</view>