<!-- 顶部状态栏 -->
<view class="status-bar"></view>

<!-- 导航栏容器 -->
<view class="nav-container">
  <!-- 主标题 -->
  <!-- <view class="nav-title">古典书籍</view> -->
  <!-- 导航标签 -->
  <scroll-view class="nav-tabs" scroll-x>
    <block wx:for="{{tabs}}" wx:key="index">
      <view class="tab-item {{currentTab === index ? 'active' : ''}}" bindtap="switchTab" data-index="{{index}}" data-url="{{item.url}}">
        {{item.name}}
      </view>
    </block>
  </scroll-view>
</view>

<!-- 古籍展示页面 -->
<view class="container">
  <!-- 标题区 -->
  <view class="header">
    <text class="title">国学典籍珍藏</text>
    <text class="subtitle">传世经典 · 永恒智慧</text>
  </view>

<!-- 古文搜索栏  数据需要js-->
<!-- 在导航栏容器下方添加搜索栏 -->
<view class="search-container">
  <view class="search-bar">
    <!-- <image class="search-icon" src="/images/search-icon.png"></image> -->
    <input 
      class="search-input" 
      placeholder="请输入古诗文关键词" 
      placeholder-style="color:#8c7b6b"
      bindinput="handleSearchInput"
      value="{{searchKeyword}}"
    />
    <view class="search-btn" bindtap="handleSearch">搜索</view>
  </view>
</view>




