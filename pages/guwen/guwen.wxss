
/* 基础样式 */
page {
  background-color: #f0f5ff;
}

.status-bar {
  height: var(--status-bar-height);
  
}

.nav-container {
  padding: 0rpx 30rpx;
  background-color: #fff;
}

/* .nav-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #000;
  margin-bottom: 20rpx;
} */

.nav-tabs {
  width: 100%;
  white-space: nowrap;
}

.tab-item {
  display: inline-block;
  font-size: 30rpx;
  color: #666;
  margin-right: 40rpx;
  padding-bottom: 10rpx;
}

.tab-item.active {
  color: #07C160;
  border-bottom: 4rpx solid #07C160;
}

/* 基础样式 */
.container {
  padding: 30rpx;
  background-color: #f9f5e9;
}

/* 标题区 */
.header {
  text-align: center;
  margin-bottom: 50rpx;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  color: #5c3b21;
  display: block;
}

.subtitle {
  font-size: 28rpx;
  color: #8c7b6b;
  margin-top: 10rpx;
}

/* 古文搜索栏目    （js还没写，不要忘记）  */
/* 搜索容器 */
/* 修改搜索容器 */
/* 精准还原图片样式的CSS */
/* 搜索容器 */
.search-container {
  margin-top: -53rpx;
  padding: 30rpx 40rpx;
  background: linear-gradient(to right, #f9f5e9, #fff5e6);
}

.search-bar {
  justify-content: space-between;
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 50rpx !important;
  padding: 20rpx 70rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.08) !important;
}

/* 搜索图标 */
.search-icon {
  width: 50rpx;
  height: 50rpx;
  margin-right: 20rpx;
}

/* 输入框 */
.search-input {
  padding-left: 0 !important;
  margin-left: -5rpx;
  width: calc(100% - 160rpx);
  flex: 1;
  font-size: 28rpx;
  color: #5c3b21;
  padding: 0 20rpx;
}

/* 搜索按钮 */
.search-btn {
  margin-right: -30rpx !important;
  background: #5c3b21;
  color: #fff;
  padding: 16rpx 40rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
}

/* 书籍卡片 */
.book-list {
  display: flex;
  flex-direction: column;
  gap: 40rpx;
}

.book-card {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 6rpx 18rpx rgba(0,0,0,0.08);
  display: flex;
}

.book-cover {
  width: 260rpx;
  height: 360rpx;
}

.book-info {
  flex: 1;
  padding: 30rpx;
  position: relative;
}

/* 文字样式 */
.series {
  font-size: 24rpx;
  color: #b8860b;
  display: block;
  margin-bottom: 10rpx;
}

.book-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin: 15rpx 0;
}

.author-line {
  display: flex;
  gap: 20rpx;
  margin: 25rpx 0;
}

.author, .annotator {
  font-size: 26rpx;
  color: #666;
}

.tagline {
  font-size: 28rpx;
  color: #8b4513;
  margin: 20rpx 0;
  display: block;
}

