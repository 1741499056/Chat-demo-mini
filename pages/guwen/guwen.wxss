  position: absolute;
  bottom: 30rpx;
  font-size: 24rpx;
  color: #888;
}

.publisher text {
  display: block;
  margin-top: 8rpx;
}

.seal {
  width: 50rpx;
  height: 50rpx;
  position: absolute;
  right: 0;
  top: -60rpx;
}