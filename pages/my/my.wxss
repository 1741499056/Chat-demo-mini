/* my页面样式 */
page {
  height: 100%;
  /* overflow: hidden; 禁止页面滚动 */
}

.me-container {
  padding: 20rpx;
  background: linear-gradient(to bottom, #f0f8ff, #e6f2ff);
  min-height: 100vh;
  box-sizing: border-box;
  overflow: hidden; /* 防止内容溢出 */
  display: flex;
  flex-direction: column;
  
}

.content-card {
  width: 100%;
  background: linear-gradient(135deg, #e6f2ff, #f0f8ff);
  border-radius: 20rpx;
  margin-bottom: 30rpx;
  box-shadow: none;
  border: 1rpx solid rgba(0, 114, 255, 0.1);
  box-sizing: border-box;
}

.user-card {
  display: flex;
  align-items: flex-start;
  padding: 40rpx 32rpx;
  background: linear-gradient(135deg, #e6f7ff, #f0faff);
  position: relative;
  min-height: 240rpx;
  border-left: 1rpx solid rgba(0, 114, 255, 0.1);
  border-right: 1rpx solid rgba(0, 114, 255, 0.1);
  border-bottom: 1rpx solid rgba(0, 114, 255, 0.1);
  border-top: none;
  padding-top: 20rpx;
  margin: 0 20rpx;
  box-sizing: border-box;
}

.avatar-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 20rpx;
}

.user-avatar {
  width: 190rpx;
  height: 190rpx;
  border-radius: 50%;
  border: 8rpx solid rgba(255,255,255,0.8);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.grade-info {
  margin-top: 15rpx;
  text-align: center;
}

.current-grade {
  font-size: 24rpx;
  color: #666;
  background: rgba(255, 255, 255, 0.7);
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  display: inline-block;
  max-width: 180rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.user-detail {
  flex: 1;
  margin-top: 20rpx;
}

.user-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 15rpx;
  margin-top: 0;
}

.user-desc {
  font-size: 26rpx;
  color: #666;
  display: block;
  margin-top: 0;
}

.button-group {
  position: absolute;
  right: 32rpx;
  bottom: 29rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 10rpx;
}

.grade-setting-btn {
  width: 160rpx;
  height: 64rpx;
  line-height: 40rpx;
  font-size: 26rpx;
  color: #1989fa;
  background-color: rgba(25, 137, 250, 0.1);
  border-radius: 32rpx;
  border: none;
}

.bg-setting-btn {
  width: 160rpx;
  height: 64rpx;
  line-height: 40rpx;
  font-size: 26rpx;
  color: #07c160;
  background-color: rgba(7, 193, 96, 0.1);
  border-radius: 32rpx;
  border: none;
}

.login-btn {
  width: 160rpx;
  height: 64rpx;
  line-height: 40rpx;
  font-size: 26rpx;
  color: #ffffff;
  background-color: #07c160;
  border-radius: 32rpx;
  border: none;
  position: absolute;
  right: 32rpx;
  bottom: 29rpx;
}

.tabs-card {
  background: linear-gradient(135deg, #e6f2ff, #d9ecff);
  border-top: 1rpx solid rgba(0, 114, 255, 0.1);
  border-bottom: 1rpx solid rgba(0, 114, 255, 0.1);
  margin-top: 30rpx;
  box-sizing: border-box;
}

.nav-tabs {
  display: flex;
  width: 100%;
}

.nav-tab {
  flex: 1;
  text-align: center;
  padding: 28rpx 0;
  font-size: 30rpx;
  color: #666;
  position: relative;
  background-color: transparent;
}

.nav-tab.active {
  color: #07c160;
  font-weight: 500;
}

.nav-tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 80rpx;
  height: 6rpx;
  background-color: #07c160;
  border-radius: 3rpx;
}

.list-card {
  background: linear-gradient(135deg, #e6f7ff, #f0faff);
  border-bottom: none;
  box-sizing: border-box;
}

.nav-list {
  width: 100%;
}

.nav-item {
  display: flex;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid rgba(0, 114, 255, 0.1);
  background-color: rgba(255,255,255,0.6);
  box-sizing: border-box;
}

.nav-item:last-child {
  border-bottom: none;
}

.nav-icon {
  width: 44rpx;
  height: 44rpx;
  margin-right: 24rpx;
}

.nav-text {
  flex: 1;
  font-size: 30rpx;
  color: #333;
}

.nav-arrow {
  width: 32rpx;
  height: 32rpx;
  opacity: 0.5;
}

.logout-btn {
  margin-top: 20rpx;
  padding: 30rpx 0;
  text-align: center;
  border: 1rpx solid #ff0000;
  background-color: #e6f2ff;
  color: #ff0000;
  font-size: 34rpx;
  border-radius: 10rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
  margin-left: 20rpx;
  margin-right: 20rpx;
  width: calc(100% - 40rpx);
  box-sizing: border-box;
}

.logout-btn-disabled {
  background-color: #f0f0f0 !important;
  color: #999 !important;
  border: 1rpx solid #e0e0e0 !important;
  cursor: not-allowed;
}