/* 全局样式 - 淡蓝色背景 */
page {
  background: linear-gradient(to bottom, #f0f8ff, #e6f2ff);
  min-height: 100vh;
}

/* 页面容器 */
.container {
  padding: 20rpx; /* 恢复内边距，作为整体边距 */
}

/* 统一卡片样式 - 带淡蓝色渐变 */
.content-card {
  width: 100%;
  background: linear-gradient(135deg, #e6f2ff, #f0f8ff);
  border-radius: 20rpx; /* 移除圆角 */
  margin-bottom: 30rpx; /* 移除底部间距 */
  box-shadow: none; /* 移除阴影 */
  border: 1rpx solid rgba(0, 114, 255, 0.1); /* 统一边框 */
}

/* 用户信息区域 */
.user-card {
  display: flex;
  align-items: flex-start;
  padding: 40rpx 32rpx;
  background: linear-gradient(135deg, #e6f7ff, #f0faff);
  position: relative;
  height: 240rpx;
  border-left: 1rpx solid rgba(0, 114, 255, 0.1);
  border-right: 1rpx solid rgba(0, 114, 255, 0.1);
  border-bottom: 1rpx solid rgba(0, 114, 255, 0.1);
  border-top: none;
  padding-top: 20rpx;
  margin: 0 20rpx; /* 只设置左右边距为20rpx */
  box-sizing: border-box; /* 确保边框和内边距包含在元素总宽度内 */

}
.user-avatar {
  width: 190rpx;
  height: 190rpx;
  border-radius: 50%;
  border: 8rpx solid rgba(255,255,255,0.8);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.user-detail {
  flex: 1;
  margin-left: 10rpx;
  margin-top: 20rpx; /* 增加上边距使整体下移 */
}

.user-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 15rpx; /* 保持原有间距 */
  margin-top: 0; /* 重置上边距 */
}

.user-desc {
  font-size: 26rpx;
  color: #666;
  display: block;
  margin-top: 0; /* 重置上边距 */
}

.bg-setting-btn {
  width: 160rpx;
  height: 64rpx;
  line-height: 40rpx;
  font-size: 26rpx;
  color: #07c160;
  background-color: rgba(7, 193, 96, 0.1);
  border-radius: 32rpx;
  border: none;
  position: absolute;
  right: 32rpx;
  bottom: 29rpx;
}

/* 选项卡卡片 - 强化渐变效果 */
.tabs-card {
  background: linear-gradient(135deg, #e6f2ff, #d9ecff);
  border-top: 1rpx solid rgba(0, 114, 255, 0.1); /* 添加上边框 */
  border-bottom: 1rpx solid rgba(0, 114, 255, 0.1); /* 添加下边框 */
  margin-top: 30rpx;
}

.nav-tabs {
  display: flex;
  width: 100%;
}

.nav-tab {
  flex: 1;
  text-align: center;
  padding: 28rpx 0;
  font-size: 30rpx;
  color: #666;
  position: relative;
  background-color: transparent;
}

.nav-tab.active {
  color: #07c160;
  font-weight: 500;
}

.nav-tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 80rpx;
  height: 6rpx;
  background-color: #07c160;
  border-radius: 3rpx;
}

/* 功能列表卡片 */
.list-card {
  background: linear-gradient(135deg, #e6f7ff, #f0faff);
  border-bottom: none; /* 移除底部边框 */
}

.nav-list {
  width: 100%;
}

.nav-item {
  display: flex;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid rgba(0, 114, 255, 0.1);
  background-color: rgba(255,255,255,0.6);
}

.nav-item:last-child {
  border-bottom: none;
}

.nav-icon {
  width: 44rpx;
  height: 44rpx;
  margin-right: 24rpx;
}

.nav-text {
  flex: 1;
  font-size: 30rpx;
  color: #333;
}

.nav-arrow {
  width: 32rpx;
  height: 32rpx;
  opacity: 0.5;
}