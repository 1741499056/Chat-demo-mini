/* pages/poem/detail/index.wxss */

/* ================== 全局设置 ================== */
page {
  background-color: #f2f6fc;
  height: 100vh;
  overflow: hidden;
}

.main-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  position: relative;
  z-index: 1;
}

.nav-placeholder {
  height: 20rpx;
}

/* ================== 悬浮控制组件 (Navigation) ================== */
.movable-area {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 999;
}

.movable-btn {
  pointer-events: auto;
  width: auto;
  height: auto;
  left: 20rpx;
  top: 70vh;
}

.control-wrapper {
  background: rgba(44, 109, 204, 0.9);
  box-shadow: 0 4rpx 16rpx rgba(44, 109, 204, 0.35);
  border-radius: 50rpx;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s;
  overflow: hidden;
}

.control-wrapper.expanded {
  padding: 0 30rpx;
  height: 90rpx;
  border-radius: 45rpx;
  background: #3a7bd5;
}

.control-icon {
  width: 90rpx;
  height: 90rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-text {
  font-size: 32rpx;
  font-weight: bold;
}

.control-menu {
  display: flex;
  align-items: center;
  white-space: nowrap;
}

.menu-item {
  font-size: 28rpx;
  padding: 10rpx 10rpx;
}

.menu-divider {
  margin: 0 16rpx;
  font-size: 24rpx;
  opacity: 0.5;
}

.menu-close {
  font-size: 40rpx;
  margin-left: 20rpx;
  line-height: 1;
  opacity: 0.8;
}

/* ================== 回到原文按钮 (Footer Action) ================== */
.back-to-origin-btn {
  position: fixed;
  bottom: 80rpx;
  right: -120rpx; /* 默认隐藏在屏幕外 */
  background: rgba(58, 123, 213, 0.9);
  color: #fff;
  padding: 16rpx 24rpx;
  border-radius: 40rpx 0 0 40rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.2);
  z-index: 998;
  display: flex;
  align-items: center;
  gap: 8rpx;
  transition: right 0.3s cubic-bezier(0.18, 0.89, 0.32, 1.28);
  font-size: 26rpx;
}

.back-to-origin-btn.show {
  right: 0;
}

.back-icon {
  font-weight: bold;
  font-size: 30rpx;
}

/* ================== 顶部标题区 (Header) ================== */
.scroll-content {
  flex: 1;
  height: 0;
  width: 100%;
  box-sizing: border-box;
  padding: 0 24rpx;
}

.title-section {
  position: relative;
  margin-top: 20rpx;
  margin-bottom: 40rpx;
  padding: 0 10rpx;
  text-align: center;
}

.poem-title {
  font-size: 54rpx;
  font-weight: bold;
  color: #2c3e50;
  display: inline-block;
  max-width: 90%;
}

.recite-btn {
  position: absolute;
  top: 50%;
  right: 10rpx;
  transform: translateY(-50%);
  background: #3a7bd5;
  color: #fff;
  padding: 12rpx 30rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 500;
  box-shadow: 0 4rpx 10rpx rgba(58, 123, 213, 0.4);
  z-index: 10;
}

.author-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 0 0 40rpx;
}

.dynasty-badge {
  background: rgba(58, 123, 213, 0.1);
  color: #3a7bd5;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  margin-bottom: 12rpx;
}

.author-name {
  font-size: 38rpx;
  font-weight: bold;
  color: #2c3e50;
  letter-spacing: 2rpx;
}

/* ================== 通用卡片容器 (Card) ================== */
.card-section {
  background: #fff;
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.03);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx dashed #eee;
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #3a7bd5;
  position: relative;
  padding-left: 20rpx;
}

.card-title::before {
  content: "";
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 8rpx;
  height: 32rpx;
  background: #3a7bd5;
  border-radius: 4rpx;
}

/* 工具栏开关 */
.tools-row {
  display: flex;
  gap: 20rpx;
}

.tool-toggle {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #999;
  background: #f8f8f8;
  padding: 6rpx 20rpx;
  border-radius: 24rpx;
  transition: all 0.2s;
}

.toggle-icon {
  width: 16rpx;
  height: 16rpx;
  border: 2rpx solid #ccc;
  border-radius: 50%;
  margin-right: 8rpx;
}

.tool-toggle.active {
  background: #e6f0ff;
  color: #3a7bd5;
}

.tool-toggle.active .toggle-icon {
  background: #3a7bd5;
  border-color: #3a7bd5;
}

/* ================== 核心：古文排版 (Poem Body) ================== */
.poem-body {
  display: flex;
  flex-direction: column;
}

.paragraph-spacer {
  height: 0;
  margin-bottom: 50rpx;
}

.poem-line-wrapper {
  margin-bottom: 30rpx;
  text-align: justify;
}

/* 原文行 */
.origin-line {
  display: block;
  font-size: 42rpx;
  color: #2c3e50;
  line-height: 1.6;
  font-family: "STKaiti", "KaiTi", serif;
  letter-spacing: 2rpx;
  font-weight: 500;
}

/* 注释高亮逻辑 */
.segment-container {
  display: inline;
}

.note-segment-wrapper {
  display: inline-block;
  position: relative;
  padding: 0 2rpx;
}

.highlight-wrapper .char-text {
  color: #3a7bd5;
  border-bottom: 2rpx solid rgba(58, 123, 213, 0.3);
  padding-bottom: 2rpx;
}

.sup-badge {
  position: absolute;
  top: -10rpx;
  right: -14rpx;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  color: #fff;
  background: #3a7bd5;
  min-width: 26rpx;
  height: 26rpx;
  border-radius: 13rpx;
  text-align: center;
  transform: scale(0.85);
}

/* 译文样式 */
.trans-text {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #7f8c8d;
  text-align: justify;
  line-height: 1.5;
  padding-left: 2rpx;
}

.card-footer-btn {
  margin-top: 20rpx;
  padding: 20rpx 0;
  text-align: center;
  background-color: #f9fbfd;
  border-radius: 12rpx;
  color: #3a7bd5;
  font-size: 28rpx;
  font-weight: 500;
  border: 1rpx solid #eef2f8;
}

.card-footer-btn:active {
  background-color: #eef5fc;
}

/* ================== 注释列表区 (Annotations) ================== */
.annotation-list {
  display: flex;
  flex-direction: column;
}

.annotation-row {
  display: flex;
  margin-bottom: 20rpx;
  padding: 16rpx;
  border-radius: 12rpx;
  transition: background 0.4s;
  align-items: flex-start;
  border: 1rpx solid #f0f0f0;
  background: #fcfcfc;
}

.annotation-row.active-highlight {
  background: #fff6e0;
  border: 1rpx solid #ffeeba;
}

.anno-num {
  width: 36rpx;
  height: 36rpx;
  background: #e6f0ff;
  color: #3a7bd5;
  font-size: 22rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
  margin-top: 6rpx;
}

.anno-content {
  flex: 1;
  font-size: 30rpx;
  color: #555;
  line-height: 1.6;
  text-align: justify;
  word-break: break-all;
}

/* ================== 其他文本内容 (赏析等) ================== */
.text-content {
  font-size: 30rpx;
  color: #444;
  line-height: 1.8;
  text-align: justify;
  text-indent: 2em;
}

/* ================== 相关推荐列表 ================== */
.related-list {
  display: flex;
  flex-direction: column;
}

.related-item {
  padding: 24rpx;
  background: #fcfcfc;
  border: 1rpx solid #f0f0f0;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.rel-name {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
}

.rel-author {
  font-size: 24rpx;
  color: #999;
}
