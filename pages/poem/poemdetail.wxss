/* pages/poem/detail/index.wxss */

/* ================== 全局设置 ================== */
page {
  background-color: #f2f6fc;
  height: 100vh;
  overflow: hidden;
}

.main-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  position: relative;
  z-index: 1;
}

.nav-placeholder {
  height: 20rpx;
}

/* ================== 悬浮控制组件 (Navigation) ================== */
.movable-area {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 999;
}

.movable-btn {
  pointer-events: auto;
  width: auto;
  height: auto;
  left: 20rpx;
  top: 70vh;
}

.control-wrapper {
  background: rgba(44, 109, 204, 0.9);
  box-shadow: 0 4rpx 16rpx rgba(44, 109, 204, 0.35);
  border-radius: 50rpx;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s;
  overflow: hidden;
}

.control-wrapper.expanded {
  padding: 0 30rpx;
  height: 90rpx;
  border-radius: 45rpx;
  background: #3a7bd5;
}

.control-icon {
  width: 90rpx;
  height: 90rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-text {
  font-size: 32rpx;
  font-weight: bold;
}

.control-menu {
  display: flex;
  align-items: center;
  white-space: nowrap;
}

.menu-item {
  font-size: 28rpx;
  padding: 10rpx 10rpx;
}

.menu-divider {
  margin: 0 16rpx;
  font-size: 24rpx;
  opacity: 0.5;
}

.menu-close {
  font-size: 40rpx;
  margin-left: 20rpx;
  line-height: 1;
  opacity: 0.8;
}

/* ================== AI 智能浮窗按钮 ================== */
/* 提示小窗口样式 */
.ai-tip-toast {
  position: fixed;
  bottom: 300rpx; 
  left: 50%;
  transform: translateX(-50%);
  background: rgba(0, 0, 0, 0.75);
  color: #ffffff;
  padding: 16rpx 32rpx;
  border-radius: 40rpx;
  font-size: 26rpx;
  z-index: 1;
  pointer-events: none; 
  opacity: 0;
  transition: all 0.3s ease;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.2);
  white-space: nowrap;
}

/* 显示状态 */
.ai-tip-toast.show {
  opacity: 1;
  bottom: 320rpx; /* 向上微微浮动的效果 */
}
.ai-float-btn {
  position: fixed;
  bottom: 160rpx;
  left: 50%;
  transform: translateX(-50%) translateY(100rpx) scale(0.9);
  opacity: 0;
  z-index: 1000;
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  pointer-events: none;
}

.ai-float-btn.visible {
  transform: translateX(-50%) translateY(0) scale(1);
  opacity: 1;
  pointer-events: auto;
}

.ai-btn-inner {
  background: #2c3e50;
  color: #fff;
  padding: 20rpx 40rpx;
  border-radius: 60rpx;
  box-shadow: 0 10rpx 30rpx rgba(44, 62, 80, 0.3);
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.ai-emoji {
  font-size: 36rpx;
  animation: pulse 2s infinite;
}

.ai-tip {
  font-size: 30rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
}

@keyframes pulse {
  0% { transform: scale(1); }
  50% { transform: scale(1.25); }
  100% { transform: scale(1); }
}

/* ================== 标题与作者区 ================== */
.scroll-content {
  flex: 1;
  height: 0;
  width: 100%;
  box-sizing: border-box;
  padding: 0 24rpx;
}

.title-section {
  position: relative;
  margin-top: 20rpx;
  margin-bottom: 40rpx;
  padding: 0 10rpx;
  text-align: center;
}

.poem-title {
  font-size: 54rpx;
  font-weight: bold;
  color: #2c3e50;
  display: inline-block;
  max-width: 90%;
}

.author-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 0 0 40rpx;
}

.dynasty-badge {
  background: rgba(58, 123, 213, 0.1);
  color: #3a7bd5;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  margin-bottom: 12rpx;
}

.author-name {
  font-size: 38rpx;
  font-weight: bold;
  color: #2c3e50;
  letter-spacing: 2rpx;
}

/* ================== 卡片组件通用样式 ================== */
.card-section {
  background: #fff;
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.03);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx;
  border-bottom-style: dashed;
  border-bottom-color: #eee;
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #3a7bd5;
  position: relative;
  padding-left: 20rpx;
}

.card-title::before {
  content: "";
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 8rpx;
  height: 32rpx;
  background: #3a7bd5;
  border-radius: 4rpx;
}

/* 工具栏与开关 */
.tools-row {
  display: flex;
  gap: 20rpx;
}

.tool-toggle {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #999;
  background: #f8f8f8;
  padding: 6rpx 20rpx;
  border-radius: 24rpx;
  transition: all 0.2s;
}

.toggle-icon {
  width: 16rpx;
  height: 16rpx;
  border: 2rpx solid #ccc;
  border-radius: 50%;
  margin-right: 8rpx;
}

.tool-toggle.active {
  background: #e6f0ff;
  color: #3a7bd5;
}

.tool-toggle.active .toggle-icon {
  background: #3a7bd5;
  border-color: #3a7bd5;
}

/* ================== 诗词原文正文 ================== */
.poem-body {
  display: flex;
  flex-direction: column;
}

.poem-line-wrapper {
  margin-bottom: 30rpx;
  text-align: justify;
}

.origin-line {
  display: block;
  font-size: 42rpx;
  color: #2c3e50;
  line-height: 1.6;
  font-family: "STKaiti", "KaiTi", serif;
  letter-spacing: 2rpx;
  font-weight: 500;
}

/* 原文段落首行缩进 */
.is-first-paragraph {
  padding-left: 2em;
}

.segment-container {
  display: inline;
}

.note-segment-wrapper {
  display: inline-block;
  position: relative;
  padding: 0 2rpx;
}

.highlight-wrapper .char-text {
  color: #3a7bd5;
  border-bottom: 2rpx solid rgba(58, 123, 213, 0.3);
  padding-bottom: 2rpx;
}

.sup-badge {
  position: absolute;
  top: -10rpx;
  right: -14rpx;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  color: #fff;
  background: #3a7bd5;
  min-width: 26rpx;
  height: 26rpx;
  border-radius: 13rpx;
  transform: scale(0.85);
}

/* Editor 选读视图样式 */
.editor-wrapper {
  width: 100%;
  min-height: 200rpx;
}

.ql-editor-view {
  width: 100%;
  height: auto;
  font-family: "STKaiti", "KaiTi", serif;
  font-size: 42rpx;
  color: #2c3e50;
  line-height: 1.6;
}

.hint-text {
  font-size: 24rpx;
  color: #999;
  text-align: center;
  margin-top: 30rpx;
  background: #f8f8f8;
  padding: 12rpx;
  border-radius: 12rpx;
}

/* ================== 译文与赏析段落 ================== */
.text-content {
  font-size: 32rpx;
  color: #444;
  line-height: 1.8;
  text-align: justify;
  padding: 10rpx 0;
}

/* 每一段译文/赏析的样式 */
.para-item {
  text-indent: 2em;
  margin-bottom: 24rpx;
  display: block;
}

/* 最后一个段落不需要下边距 */
.para-item:last-child {
  margin-bottom: 0;
}

.no-data-text {
  color: #999;
  font-size: 28rpx;
  text-align: center;
  display: block;
  width: 100%;
  padding: 20rpx 0;
}

/* ================== 注释列表 ================== */
.annotation-list {
  display: flex;
  flex-direction: column;
}

.annotation-row {
  display: flex;
  margin-bottom: 20rpx;
  padding: 16rpx;
  border-radius: 12rpx;
  transition: background 0.4s;
  align-items: flex-start;
  border: 1rpx solid #f0f0f0;
  background: #fcfcfc;
}

.annotation-row.active-highlight {
  background: #fff6e0;
  border: 1rpx solid #ffeeba;
}

.anno-num {
  width: 36rpx;
  height: 36rpx;
  background: #e6f0ff;
  color: #3a7bd5;
  font-size: 22rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
  margin-top: 6rpx;
}

.anno-content {
  flex: 1;
  font-size: 30rpx;
  color: #555;
  line-height: 1.6;
  text-align: justify;
  word-break: break-all;
}

/* ================== AI 弹窗样式 ================== */
.ai-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.5);
  z-index: 2000;
  display: flex;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(4px);
}

.ai-modal-content {
  width: 85%;
  max-height: 70vh;
  background: #fff;
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.2);
  animation: modalPop 0.3s ease-out;
}

@keyframes modalPop {
  from { transform: scale(0.95); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}

.ai-modal-header {
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #f9fbfd;
}

.ai-modal-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #2c3e50;
}

.ai-modal-close {
  font-size: 44rpx;
  color: #999;
  line-height: 1;
  padding: 0 10rpx;
}

.ai-modal-body {
  padding: 30rpx;
  min-height: 200rpx;
  box-sizing: border-box;
  overflow-y: auto;
}

.selected-quote {
  font-size: 30rpx;
  color: #3a7bd5;
  font-weight: bold;
  margin-bottom: 30rpx;
  padding: 20rpx;
  border-left: 8rpx solid #3a7bd5;
  background: #f0f7ff;
  border-radius: 8rpx;
  font-family: "STKaiti", serif;
}

.ai-result-text {
  font-size: 32rpx;
  color: #333;
  line-height: 1.7;
  text-align: justify;
  white-space: pre-wrap; /* 允许 AI 返回的内容识别换行符 */
}

.loading-dots {
  padding: 20rpx 0;
  color: #999;
  font-size: 26rpx;
  text-align: center;
}

.recite {
  position: absolute;
  top: 5rpx;
  right:0rpx;
  z-index: 2;
  height: 80rpx;
  width: 80rpx;
  text-align: center;
  line-height: 80rpx;
  background: rgba(44, 109, 204, 0.9);
  border-radius: 50%;
  color: #fff;
}

