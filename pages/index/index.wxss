/* index.wxss */
.container {
  position: relative;
  height: 100vh;
  /* overflow: hidden; */
}

.background-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

/* 原有导航栏适配 */
.nav-container {
  position: relative;
  z-index: 2;
}

/* 新增诗意卡片 */
.poem-card {
  position: relative;
  z-index: 1;
  background: rgba(255,255,255,0.9);
  border-radius: 24rpx;
  padding: 40rpx;
  margin: 40rpx;
  box-shadow: 0 8rpx 24rpx rgba(92,59,33,0.1);
}

.poem-title {
  display: block;
  font-size: 40rpx;
  color: #5c3b21;
  margin-bottom: 20rpx;
  font-weight: bold;
}

.poem-content {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
  white-space: pre-wrap;
}
.background-text {
  position: absolute;
  top: 20%; /* 根据原图空白区域定位 */
  left: 50%;
  transform: translateX(-50%);
  text-align: center;
  width: 80%;
}

.title-line {
  font-size: 59rpx;
  font-weight: bold;
  color: #F5F5DC;
  text-shadow: 0 4rpx 12rpx rgba(0,82,158,0.3);
  display: block;
  margin-bottom: 20rpx;
  font-family: "华文楷体";
  letter-spacing: 0rpx;
  position: relative;
  top: -90rpx;
}

.subtitle-line {
  font-size: 55rpx;
  font-weight: 990;
  color: #F5F5DC;
  letter-spacing: 0rpx;
  display: block;
  opacity: 0.9;
  font-family: "华文楷体";
  position: relative;
  top: -80rpx;
}
