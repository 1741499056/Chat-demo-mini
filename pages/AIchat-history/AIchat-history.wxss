/* pages/AIchat-history/AIchat-history.wxss */
.history-container {
  height: 100vh;
  background: linear-gradient(135deg, #f5f5f5 0%, #efebe9 100%);
  font-family: "STKaiti", "KaiTi", "楷体", serif;
}

.header {
  background: linear-gradient(135deg, rgba(121, 85, 72, 0.95) 0%, rgba(62, 39, 35, 0.95) 100%);
  color: #f5f5f5;
  padding: 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.1);
}

.title {
  font-size: 36rpx;
  font-weight: bold;
}

.back-btn {
  background: rgba(255, 255, 255, 0.2);
  padding: 16rpx 24rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.3);
}

.loading {
  padding: 60rpx;
  text-align: center;
}

.loading-text {
  font-size: 28rpx;
  color: #8d6e63;
  margin-bottom: 30rpx;
}

.conversation-list {
  height: calc(100vh - 120rpx);
  padding: 20rpx;
}

.conversation-item {
  background: rgba(255, 253, 245, 0.9);
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid #d7ccc8;
  box-shadow: 0 4rpx 12rpx rgba(121, 85, 72, 0.1);
  position: relative;
}

.clickable-area {
  /* 可点击区域覆盖大部分内容 */
}

.conversation-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.title-section {
  display: flex;
  align-items: center;
  flex: 1;
  margin-right: 20rpx;
}

.conversation-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #5d4037;
  flex: 1;
}

.action-buttons {
  position: absolute;
  top: 30rpx;
  right: 30rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  z-index: 10;
}

.rename-btn {
  background: rgba(121, 85, 72, 0.1);
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  border: 1rpx solid #8d6e63;
  color: #5d4037;
  font-size: 24rpx;
  text-align: center;
}

.rename-btn:active {
  background: rgba(121, 85, 72, 0.2);
}

.delete-btn {
  background: #f44336;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  border: 1rpx solid #d32f2f;
  color: white;
  font-size: 24rpx;
  text-align: center;
}

.delete-btn:active {
  background: #d32f2f;
}

.conversation-time {
  font-size: 24rpx;
  color: #8d6e63;
  white-space: nowrap;
}

.rename-input-container {
  margin: 20rpx 0;
  padding: 20rpx;
  background: rgba(255, 255, 255, 0.8);
  border-radius: 12rpx;
  border: 1rpx solid #d7ccc8;
}

.rename-input {
  background: white;
  padding: 20rpx;
  border-radius: 8rpx;
  border: 1rpx solid #bcaaa4;
  margin-bottom: 20rpx;
  font-size: 28rpx;
}

.rename-actions {
  display: flex;
  justify-content: flex-end;
  gap: 20rpx;
}

.rename-confirm, .rename-cancel {
  padding: 12rpx 24rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
}

.rename-confirm {
  background: #4caf50;
  color: white;
}

.rename-cancel {
  background: #f44336;
  color: white;
}

.rename-confirm:active {
  background: #45a049;
}

.rename-cancel:active {
  background: #da190b;
}

.conversation-preview {
  margin-bottom: 16rpx;
}

.conversation-preview text {
  font-size: 28rpx;
  color: #6d4c41;
  line-height: 1.4;
}

.conversation-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.conversation-id {
  font-size: 22rpx;
  color: #bcaaa4;
}

.conversation-status {
  font-size: 24rpx;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
}

.conversation-status.normal {
  background: rgba(76, 175, 80, 0.1);
  color: #4caf50;
}

.conversation-status.archived {
  background: rgba(158, 158, 158, 0.1);
  color: #9e9e9e;
}

.load-more {
  text-align: center;
  padding: 30rpx;
  color: #8d6e63;
  background: rgba(255, 253, 245, 0.9);
  border-radius: 16rpx;
  border: 1rpx solid #d7ccc8;
}

.empty-state {
  text-align: center;
  padding: 100rpx 40rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #8d6e63;
  display: block;
  margin-bottom: 20rpx;
}

.empty-subtext {
  font-size: 28rpx;
  color: #bcaaa4;
  display: block;
}

.detail-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  background: white;
  border-radius: 20rpx;
  width: 90%;
  max-height: 80vh;
  overflow: hidden;
}

.modal-header {
  padding: 30rpx;
  border-bottom: 1rpx solid #e0e0e0;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #5d4037;
}

.modal-close {
  font-size: 40rpx;
  color: #8d6e63;
  padding: 10rpx;
}

.modal-body {
  max-height: 60vh;
  padding: 30rpx;
}

.message-item {
  margin-bottom: 30rpx;
  padding: 20rpx;
  border-radius: 12rpx;
}

.user-message {
  background: rgba(92, 107, 192, 0.1);
  border-left: 4rpx solid #5c6bc0;
}

.assistant-message {
  background: rgba(126, 87, 194, 0.1);
  border-left: 4rpx solid #7e57c2;
}

.message-role {
  font-size: 24rpx;
  color: #8d6e63;
  margin-bottom: 8rpx;
}

.message-content {
  font-size: 28rpx;
  color: #5d4037;
  line-height: 1.4;
}

.message-time {
  font-size: 22rpx;
  color: #bcaaa4;
  text-align: right;
  margin-top: 8rpx;
}

/* 打字动画 */
.typing-indicator {
  display: flex;
  align-items: center;
  gap: 12rpx;
  justify-content: center;
}

.dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #8d6e63;
  animation: bounce 1.4s infinite ease-in-out;
}

.dot:nth-child(1) {
  animation-delay: -0.32s;
}
.dot:nth-child(2) {
  animation-delay: -0.16s;
}

@keyframes bounce {
  0%,
  80%,
  100% {
    transform: scale(0);
  }
  40% {
    transform: scale(1);
  }
}