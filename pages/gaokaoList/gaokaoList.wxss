/* pages/gaokaoList/gaokaoList.wxss */
/* 容器样式 (沿用同事代码) */
.container {
  padding: 0rpx;
  background-color: #e6f7ff; /* 淡蓝色背景 */
  min-height: 100vh;
  box-sizing: border-box;
  font-family: 'PingFang SC', 'Microsoft YaHei', sans-serif;
}

/* 页面标题 (沿用同事代码) */
.header {
  text-align: center;
  padding: 40rpx 0;
  margin-bottom: 30rpx;
}

.main-title {
  font-size: 48rpx;
  font-weight: 600;
  color: #1890ff;
  display: block;
  margin-bottom: 20rpx;
  letter-spacing: 1rpx;
}

.tips {
  font-size: 28rpx;
  color: #64748b;
  display: block;
}

/* 题目列表容器 */
.question-list {
  padding-bottom: 30rpx;
  min-height: 400rpx; /* 避免分页组件跳动 */
}

/* 题目卡片 (沿用 skill-card 基础样式并调整) */
.skill-card {
  background: white;
  border-radius: 20rpx;
  padding: 35rpx;
  margin-bottom: 35rpx;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s ease;
  border: 1rpx solid rgba(224, 240, 255, 0.8);
  /* 移除同事代码中的:active 效果，因为要作为列表项点击 */
}

.question-card {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-left: 10rpx solid #1890ff; /* 增加左侧标记 */
    padding-left: 25rpx;
}

.question-card:active {
  transform: translateY(-5rpx);
  box-shadow: 0 15rpx 40rpx rgba(0, 0, 0, 0.12);
}

.question-header {
    display: flex;
    align-items: center;
    flex: 1;
    margin-right: 20rpx;
}

.question-title {
    font-size: 36rpx;
    font-weight: 700;
    color: #1890ff;
    margin-right: 20rpx;
}

.question-content {
    font-size: 34rpx;
    color: #1e293b;
    flex: 1;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    max-width: 400rpx;
}

.view-detail-btn {
    font-size: 26rpx;
    color: #40a9ff;
    border: 1rpx solid #40a9ff;
    padding: 10rpx 20rpx;
    border-radius: 30rpx;
    background-color: #e6f7ff;
    flex-shrink: 0;
}


/* 移除 skill-header, name, difficulty, description, additional-info, generate-btn 相关的样式 */

/* 分页组件样式 */
.pagination {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 30rpx 20rpx;
    background: white;
    border-radius: 20rpx;
    box-shadow: 0 5rpx 15rpx rgba(0, 0, 0, 0.05);
    margin-top: 30rpx;
}

.page-btn {
    background: linear-gradient(to right, #1890ff, #40a9ff);
    color: white;
    font-size: 28rpx;
    padding: 15rpx 30rpx;
    border-radius: 30rpx;
    border: none;
    line-height: 1;
    box-shadow: 0 4rpx 10rpx rgba(24, 144, 255, 0.2);
    transition: all 0.2s ease;
}

.page-btn::after {
    border: none;
}

.page-btn:active {
    transform: scale(0.98);
}

.page-info {
    font-size: 30rpx;
    font-weight: 600;
    color: #1890ff;
    padding: 0 20rpx;
}

.disabled-btn {
    background: #d9d9d9;
    color: #999999;
    box-shadow: none;
    pointer-events: none; /* 禁用点击 */
}

/* 空数据提示 */
.empty-data {
    text-align: center;
    padding: 100rpx 30rpx;
    font-size: 30rpx;
    color: #999;
    display: flex;
    flex-direction: column;
    align-items: center;
}

.empty-icon {
    font-size: 60rpx;
    margin-bottom: 20rpx;
}

/* 加载状态提示 (沿用同事代码) */

.loading {
  text-align: center;
  padding: 60rpx 30rpx;
  font-size: 30rpx;
  color: #666;
  background: white;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 25rpx rgba(0, 0, 0, 0.08);
  display: flex;
  flex-direction: column;
  align-items: center;
}


.error {
  text-align: center;
  padding: 60rpx 30rpx;
  background: white;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 25rpx rgba(0, 0, 0, 0.08);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.error-icon {
  font-size: 50rpx;
  color: #f5222d;
  margin-bottom: 20rpx;
}

.error-message {
  font-size: 30rpx;
  color: #f5222d;
  margin-bottom: 30rpx;
}

.retry-btn {
  background: linear-gradient(to right, #1890ff, #40a9ff);
  color: white;
  font-size: 30rpx;
  padding: 15rpx 40rpx;
  border-radius: 30rpx;
  border: none;
  box-shadow: 0 6rpx 15rpx rgba(24, 144, 255, 0.3);
}