<!-- pages/DailyPoem/DailyPoem.wxml -->
<view class="page-container no-scroll">
  <image 
    src="https://newlan.oss-cn-shanghai.aliyuncs.com/%E7%99%BB%E5%BD%95%E8%83%8C%E6%99%AF1.png" 
    mode="aspectFill" 
    class="background-image"
  ></image>

  <view class="content-mask"></view>

  <view class="motto">
    <text>日积月累，水滴石穿</text>
  </view>
  <view class="container">
    <view class="poem-card">
      <view class="title">{{poem.title}}</view>
      <view class="author">{{poem.author || '佚名'}}·{{poem.dynasty}}</view>
      <view class="content">
        <block wx:for="{{poem.content}}" wx:key="*this">
          <view class="couplet-line">{{item}}</view>
        </block>
      </view>
      <view class="date">{{today}}</view>
    </view>
    
    <!-- 新的刷新按钮盒子 -->
    <view class="refresh-box">
      <button 
        class="refresh-button" 
        bindtap="refreshPoem"
        disabled="{{refreshing}}"
      >
        刷新诗词
        <image 
          class="refresh-icon {{refreshing ? 'refreshing' : ''}}" 
          src="https://newlan.oss-cn-shanghai.aliyuncs.com/icons/%E5%88%B7%E6%96%B0.jpg" 
        />
      </button>
    </view>
    <button class="aichat" bindtap="aichat">财务助手</button>
    <!-- <button class="recite" bindtap="recite">背诵点评</button> -->
    <button class="learnmore" bindtap="learnmore">了解更多</button>
  </view>
  
</view>