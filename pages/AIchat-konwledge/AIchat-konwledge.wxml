<!-- pages/AIchat-konwledge/AIchat-konwledge.wxml -->
<view class="chat-container">
  <!-- 头部 -->
  <view class="header">
    <text class="title">倾盖晤言，尺素传心</text>
    <view class="header-right">
      <view class="connection-info">
        <text wx:if="{{(!hasToken && !showLoginPrompt)}}" class="token-warning">⚠️ 未检测到登录信息</text>
      </view>
      <view class="history-btn" bindtap="goToHistory">历史对话</view>
    </view>
  </view>

  <!-- 聊天消息区域 -->
  <scroll-view class="chat-messages" scroll-y scroll-with-animation scroll-top="{{scrollTop}}">
    <!-- 欢迎消息和快捷按钮 -->
    <block wx:if="{{messages.length > 0 && messages[0].type === 'system' && messages[0].quickQuestions}}">
      <view class="welcome-container">
        <text class="welcome-text">{{messages[0].content}}</text>
        <view class="quick-questions">
          <block wx:for="{{messages[0].quickQuestions}}" wx:key="id">
            <view class="quick-question-btn" bindtap="handleQuickQuestion" data-question="{{item.text}}">
              {{item.text}}
            </view>
          </block>
        </view>
      </view>
    </block>

    <!-- 普通消息列表（跳过第一条系统欢迎消息） -->
    <block wx:for="{{messages}}" wx:key="id">
      <block wx:if="{{!(index === 0 && messages[0].type === 'system' && messages[0].quickQuestions)}}">
        <view class="message {{item.type}}">
  <view class="message-content">
    <!-- 思考部分：默认显示，可切换 -->
    <view wx:if="{{item.hasThink}}" class="think-section">
      <view class="think-toggle" bindtap="toggleThink" data-index="{{index}}">
        <text class="toggle-icon">{{item.showThink ? '▼' : '▶'}}</text>
        <text class="toggle-text">{{item.showThink ? '隐藏思考过程' : '显示思考过程'}}</text>
      </view>
      <view wx:if="{{item.showThink}}" class="think-content">
        <text class="think-text">{{item.thinkContent}}</text>
      </view>
    </view>
    <!-- 主内容 -->
    <text class="message-text">{{item.content}}</text>
  </view>
  <text class="message-time">{{item.time}}</text>
</view>
      </block>
    </block>

    <!-- 流式输出 -->
    <view wx:if="{{isLoading}}" class="message assistant streaming">
  <view class="message-content">
    <!-- 流式思考部分：默认显示，可切换 -->
    <view wx:if="{{streamingHasThink}}" class="streaming-think-control">
      <view class="think-toggle" bindtap="toggleStreamingThink">
        <text class="toggle-icon">{{showStreamingThink ? '▼' : '▶'}}</text>
        <text class="toggle-text">{{showStreamingThink ? '隐藏思考过程' : '显示思考过程'}}</text>
      </view>
    </view>
    <view wx:if="{{showStreamingThink && streamingThinkContent}}" class="streaming-think-content">
      <text class="think-text">{{streamingThinkContent}}</text>
    </view>
    <text class="message-text">{{streamingMainContent || streamingContent}}</text>
  </view>
  <view class="typing-indicator">
    <view class="dot"></view>
    <view class="dot"></view>
    <view class="dot"></view>
  </view>
</view>
  </scroll-view>

  <!-- 输入区域 -->
  <view class="input-area">
    <input value="{{inputMessage}}" bindinput="onInput" bindconfirm="sendMessage" placeholder="输入消息与 Dify 大模型对话..." disabled="{{(!activeConnection || isLoading || !hasToken)}}" />
    <view class="send-btn {{isLoading || !inputMessage.trim() || !activeConnection || !hasToken ? 'disabled' : ''}}" bindtap="sendMessage">
      {{isLoading ? '生成中...' : '飞鸿寄声'}}
    </view>
  </view>

  <!-- 状态信息 -->
  <!-- <view class="stats"> -->
    <!-- <text wx:if="{{isLoading}}">Dify 大模型正在生成...</text> -->
  <!-- </view> -->

  <!-- 登录提示 -->
  <view wx:if="{{showLoginPrompt}}" class="login-prompt-overlay">
    <view class="login-prompt">
      <text class="prompt-title">需要登录</text>
      <text class="prompt-text">请先登录后再使用聊天功能</text>
      <view class="btn-group">
        <button bindtap="goToLogin" class="login-btn">去登录</button>
        <button bindtap="closeLoginPrompt" class="cancel-btn">取消</button>
      </view>
    </view>
  </view>
</view>