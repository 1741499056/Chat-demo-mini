/* pages/AIchat-konwledge/AIchat-konwledge.wxss */
/* 整体容器 */
.chat-container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  position: relative;
  overflow: hidden;
  font-family: "STKaiti", "KaiTi", "楷体", serif;
  color: #3e2723;
}

/* 背景图片 */
.chat-container::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: url('https://newlan.oss-cn-shanghai.aliyuncs.com/%E9%B1%BC.jpg') no-repeat center center;
  background-size: cover;
  filter: brightness(0.9) contrast(1.1);
  z-index: -1;
}

/* 头部样式 */
.header {
  background: linear-gradient(135deg, rgba(121, 85, 72, 0.95) 0%, rgba(62, 39, 35, 0.95) 100%);
  color: #f5f5f5;
  padding: 20rpx 30rpx;
  border-radius: 0 0 24rpx 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 12rpx 40rpx rgba(62, 39, 35, 0.4);
  display: flex;
  justify-content: space-between;
  align-items: center;
  position: relative;
  z-index: 1;
  border-bottom: 2rpx solid #8d6e63;
}

.header-right {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.history-btn {
  background: linear-gradient(135deg, rgba(139, 195, 74, 0.9), rgba(67, 160, 71, 0.9));
  color: white;
  padding: 12rpx 24rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
  font-weight: 600;
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  box-shadow: 0 4rpx 12rpx rgba(121, 85, 72, 0.2);
  transition: all 0.2s ease;
  cursor: pointer;
  font-family: "STKaiti", "KaiTi", "楷体", serif;
  letter-spacing: 1rpx;
  text-shadow: 1rpx 1rpx 2rpx rgba(0, 0, 0, 0.2);
  min-width: 160rpx;
  text-align: center;
}

.history-btn:active {
  transform: scale(0.95);
  opacity: 0.9;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  letter-spacing: 2rpx;
  text-shadow: 2rpx 2rpx 4rpx rgba(0, 0, 0, 0.3);
  background: linear-gradient(to right, #f5f5f5, #d7ccc8);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  padding: 0 10rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 400rpx;
}

.connection-info {
  display: flex;
  gap: 20rpx;
  align-items: center;
  flex-wrap: nowrap;
}

.status {
  padding: 12rpx 24rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
  font-weight: 600;
  background: linear-gradient(135deg, rgba(139, 195, 74, 0.9), rgba(67, 160, 71, 0.9));
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  font-family: "STKaiti", "KaiTi", "楷体", serif;
  letter-spacing: 1rpx;
  color: white;
  min-width: 160rpx;
  text-align: center;
}

.status.connected {
  background: linear-gradient(135deg, rgba(67, 160, 71, 0.9), rgba(56, 142, 60, 0.9));
}

.status.disconnected {
  background: linear-gradient(135deg, rgba(198, 40, 40, 0.9), rgba(183, 28, 28, 0.9));
}

.token-warning {
  background: linear-gradient(135deg, rgba(255, 152, 0, 0.9), rgba(255, 143, 0, 0.9));
  padding: 12rpx 24rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #fff;
  border: 1rpx solid rgba(255, 255, 255, 0.3);
}

/* 聊天消息区域 */
.chat-messages {
  flex: 1;
  background: rgba(255, 253, 245, 0.85);
  border-radius: 24rpx;
  padding: 30rpx;
  margin: 0 20rpx 20rpx;
  border: 1rpx solid #d7ccc8;
  box-shadow: 0 12rpx 40rpx rgba(121, 85, 72, 0.15);
  position: relative;
  z-index: 1;
  backdrop-filter: blur(10rpx);
  overflow-y: auto;
  display: flex;
  flex-direction: column;
}

/* 欢迎消息容器 */
.welcome-container {
  background: linear-gradient(135deg, rgba(255, 248, 225, 0.9), rgba(255, 240, 200, 0.9));
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 32rpx;
  border-left: 8rpx solid #ffa000;
  box-shadow: 2rpx 2rpx 8rpx rgba(0, 0, 0, 0.05);
  position: relative;
  z-index: 1;
}

.welcome-text {
  font-size: 32rpx;
  line-height: 1.6;
  color: #5d4037;
  display: block;
  margin-bottom: 20rpx;
  font-weight: bold;
}

.quick-questions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.quick-question-btn {
  background: linear-gradient(135deg, rgba(139, 195, 74, 0.9), rgba(67, 160, 71, 0.9));
  color: white;
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  font-size: 30rpx;
  text-align: center;
  box-shadow: 0 4rpx 12rpx rgba(121, 85, 72, 0.2);
  transition: all 0.2s ease;
  font-family: "STKaiti", "KaiTi", "楷体", serif;
  border: 1rpx solid rgba(255, 255, 255, 0.3);
}

.quick-question-btn:active {
  transform: scale(0.98);
  opacity: 0.95;
}

/* 单条消息样式 */
.message {
  margin-bottom: 32rpx;
  padding: 28rpx;
  border-radius: 16rpx;
  border-left: 8rpx solid transparent;
  transition: transform 0.12s ease;
  word-break: break-word;
  background-clip: padding-box;
  position: relative;
  box-shadow: 2rpx 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.message.user {
  background: linear-gradient(180deg, rgba(232, 234, 246, 0.9), rgba(210, 215, 238, 0.9));
  border-left-color: #5c6bc0;
  margin-left: 120rpx;
  border: 1rpx solid rgba(92, 107, 192, 0.2);
}

.message.assistant {
  background: linear-gradient(180deg, rgba(248, 246, 255, 0.9), rgba(240, 238, 254, 0.9));
  border-left-color: #7e57c2;
  margin-right: 120rpx;
  border: 1rpx solid rgba(126, 87, 194, 0.2);
}

.message.system {
  background: rgba(255, 248, 225, 0.9);
  border-left-color: #ffa000;
  text-align: center;
  color: #5d4037;
  border: 1rpx solid rgba(255, 160, 0, 0.2);
}

.message.streaming {
  background: linear-gradient(180deg, rgba(240, 254, 244, 0.9), rgba(232, 250, 240, 0.9));
  border-left-color: #4caf50;
  animation: pulse 2s infinite;
  border: 1rpx solid rgba(76, 175, 80, 0.2);
}

@keyframes pulse {
  0% { opacity: 1; }
  50% { opacity: 0.95; }
  100% { opacity: 1; }
}

.message-content {
  font-size: 32rpx;
  line-height: 1.6;
  color: #3e2723;
  position: relative;
  z-index: 1;
}

/* Markdown 样式增强 */
.message-content strong {
  font-weight: bold;
  color: #1976d2;
}

.message-content em {
  font-style: italic;
  color: #7b1fa2;
}

.message-content code {
  background: rgba(0, 0, 0, 0.05);
  padding: 4rpx 8rpx;
  border-radius: 4rpx;
  font-family: 'Courier New', monospace;
  font-size: 28rpx;
  color: #d32f2f;
  display: inline-block;
}

.message-content pre {
  background: rgba(0, 0, 0, 0.05);
  padding: 20rpx;
  border-radius: 8rpx;
  margin: 16rpx 0;
  overflow-x: auto;
  border-left: 4rpx solid #8d6e63;
  font-family: 'Courier New', monospace;
  font-size: 26rpx;
  white-space: pre-wrap;
}

.message-content blockquote {
  border-left: 4rpx solid #8d6e63;
  padding-left: 20rpx;
  margin: 16rpx 0;
  color: #6d4c41;
  font-style: italic;
  background: rgba(139, 195, 74, 0.1);
  padding: 16rpx 20rpx;
  border-radius: 0 8rpx 8rpx 0;
}

.message-content ul, .message-content ol {
  margin: 16rpx 0;
  padding-left: 40rpx;
}

.message-content li {
  margin: 8rpx 0;
  line-height: 1.5;
}

.message-content h1, .message-content .md-h1 {
  font-size: 36rpx;
  font-weight: bold;
  margin: 20rpx 0 16rpx 0;
  color: #1976d2;
  border-bottom: 2rpx solid rgba(25, 118, 210, 0.2);
  padding-bottom: 8rpx;
}

.message-content h2, .message-content .md-h2 {
  font-size: 32rpx;
  font-weight: bold;
  margin: 18rpx 0 14rpx 0;
  color: #1565c0;
  border-bottom: 1rpx solid rgba(21, 101, 192, 0.2);
  padding-bottom: 6rpx;
}

.message-content h3, .message-content .md-h3 {
  font-size: 28rpx;
  font-weight: bold;
  margin: 16rpx 0 12rpx 0;
  color: #104c92;
}

.message-content p {
  margin: 12rpx 0;
  line-height: 1.6;
}

.message-content a, .message-content .md-link {
  color: #1976d2;
  text-decoration: underline;
}

.message-time {
  font-size: 24rpx;
  color: #8d6e63;
  margin-top: 16rpx;
  text-align: right;
  font-style: italic;
}

/* 打字动画 */
.typing-indicator {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 20rpx;
  justify-content: center;
}

.dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #8d6e63;
  animation: bounce 1.4s infinite ease-in-out;
}

.dot:nth-child(1) {
  animation-delay: -0.32s;
}
.dot:nth-child(2) {
  animation-delay: -0.16s;
}

@keyframes bounce {
  0%, 80%, 100% { transform: scale(0); }
  40% { transform: scale(1); }
}

/* 输入区 */
.input-area {
  display: flex;
  gap: 20rpx;
  margin: 0 20rpx 20rpx;
  flex-wrap: wrap;
  padding: 20rpx;
  background: rgba(255, 253, 245, 0.9);
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(121, 85, 72, 0.15);
  position: relative;
  z-index: 1;
  border: 1rpx solid #d7ccc8;
}

.input-area input {
  flex: 1;
  padding: 24rpx;
  border: 1rpx solid #d7ccc8;
  border-radius: 16rpx;
  font-size: 27rpx;
  min-width: 360rpx;
  background: rgba(255, 255, 255, 0.9);
  font-family: "STKaiti", "KaiTi", "楷体", serif;
  box-shadow: inset 0 2rpx 8rpx rgba(121, 85, 72, 0.1);
}

.input-area input::placeholder {
  color: #8d6e63;
  opacity: 0.6;
}

.send-btn {
  background: linear-gradient(135deg, rgba(255, 152, 0, 0.9), rgba(255, 193, 7, 0.9));
  color: white;
  border: none;
  border-radius: 20rpx;
  font-size: 32rpx;
  padding: 0 40rpx;
  height: 88rpx;
  line-height: 88rpx;
  box-shadow: 0 6rpx 16rpx rgba(255, 152, 0, 0.4);
  transition: all 0.2s ease;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 160rpx;
  position: relative;
  overflow: hidden;
  font-family: "STKaiti", "KaiTi", "楷体", serif;
  letter-spacing: 2rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.4);
  font-weight: bold;
}

.send-btn text {
  position: relative;
  z-index: 1;
  text-shadow: 1rpx 1rpx 2rpx rgba(233, 0, 0, 0.3);
}

.send-btn::after {
  content: '';
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: radial-gradient(circle, rgba(255,255,255,0.4) 0%, rgba(255,255,255,0) 70%);
  transform: rotate(30deg);
  opacity: 0;
  transition: opacity 0.3s ease;
}

.send-btn:not(.disabled):active {
  transform: scale(0.98);
}

.send-btn:not(.disabled):hover::after {
  opacity: 1;
}

.send-btn.disabled {
  background: linear-gradient(135deg, #c1dfee, #afdcf3);
  box-shadow: none;
  color: #90a4ae;
}

.token-check-btn {
  background: linear-gradient(135deg, rgba(139, 195, 74, 0.9), rgba(67, 160, 71, 0.9));
  color: white;
  border-radius: 8rpx;
  padding: 0 28rpx;
  height: 80rpx;
  line-height: 80rpx;
  border: none;
  font-family: "STKaiti", "KaiTi", "楷体", serif;
  box-shadow: 0 4rpx 12rpx rgba(121, 85, 72, 0.3);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
}

/* 状态信息 */
.stats {
  display: flex;
  justify-content: space-between;
  background: rgba(255, 253, 245, 0.9);
  padding: 28rpx;
  margin: 0 20rpx 20rpx;
  border-radius: 20rpx;
  box-shadow: 0 12rpx 40rpx rgba(121, 85, 72, 0.15);
  font-size: 28rpx;
  color: #5d4037;
  flex-wrap: wrap;
  gap: 16rpx;
  border: 1rpx solid #d7ccc8;
  position: relative;
  z-index: 1;
}

/* 登录模态 */
.login-prompt-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(30, 30, 30, 0.7);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 1000;
}

.login-prompt {
  background: linear-gradient(135deg, #f5f5f5, #efebe9);
  padding: 56rpx;
  border-radius: 24rpx;
  text-align: center;
  box-shadow: 0 16rpx 60rpx rgba(0, 0, 0, 0.3);
  width: 80%;
  border: 1rpx solid #d7ccc8;
  position: relative;
  overflow: hidden;
}

.login-prompt::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 8rpx;
  background: linear-gradient(90deg, #8d6e63, #5d4037);
}

.prompt-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #5d4037;
  margin-bottom: 24rpx;
  display: block;
  letter-spacing: 2rpx;
}

.prompt-text {
  font-size: 32rpx;
  color: #6d4c41;
  margin-bottom: 36rpx;
  display: block;
}

.btn-group {
  display: flex;
  justify-content: center;
  gap: 20rpx;
}

.login-btn {
  background: linear-gradient(135deg, #8d6e63, #6d4c41);
  color: white;
  border: none;
  padding: 20rpx 36rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-family: "STKaiti", "KaiTi", "楷体", serif;
  box-shadow: 0 4rpx 12rpx rgba(121, 85, 72, 0.3);
}

.cancel-btn {
  background: linear-gradient(135deg, #bcaaa4, #a1887f);
  color: white;
  border: none;
  padding: 20rpx 36rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-family: "STKaiti", "KaiTi", "楷体", serif;
  box-shadow: 0 4rpx 12rpx rgba(121, 85, 72, 0.3);
}

/* 思考内容区域 */
.think-content {
  margin-top: 20rpx;
  margin-bottom: 20rpx;
  border-radius: 8rpx;
  overflow: hidden;
  background: rgba(255, 248, 225, 0.8);
  border-left: 4rpx solid #ffa000;
}

.think-content {
  background: rgba(255, 248, 225, 0.8);
  padding: 20rpx;
  border-radius: 8rpx;
  border-left: 4rpx solid #ffa000;
  font-size: 28rpx;
  line-height: 1.5;
  color: #5d4037;
  border: 1rpx solid rgba(255, 160, 0, 0.3);
}