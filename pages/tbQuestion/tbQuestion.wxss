
/* 顶部搜索栏 - 协调版 */
.search-container {
    padding: 16rpx 24rpx;
    background: #ffffff;
    border-bottom: 1rpx solid #f0f0f0;
    position: sticky;
    top: 0;
    z-index: 10;
  }
  
  .search-box {
    display: flex;
    align-items: center;
    background: #f7f8fa;
    border-radius: 48rpx;
    padding: 0 24rpx;
    height: 72rpx;
  }
  
  .search-input {
    width:200rpx;
    padding: 0 16rpx;
    font-size: 28rpx;
    color: #333;
    background: transparent;
    text-align: center;
  }
  
  .type-picker {
    position: relative;
    /* flex: 0 0 160rpx; */
     width:300rpx;
    margin-right: 16rpx;
  }
  
  .type-picker::after {
    content: "";
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 1rpx;
    height: 32rpx;
    background: #e5e6eb;
  }
  
  .picker-text {
    font-size: 28rpx;
    color: #666;
    padding: 8rpx 0;
    text-align: center;
  }
   
  .search-btn {
    width:250rpx; /* 固定宽度，数值可自行调整 */
    height: 60rpx;
    margin-left: 16rpx;
    text-align: center;
    font-size: 28rpx;
    background: #1677ff;
    color: white;
    border-radius: 28rpx;
    /* 保持按钮内部元素居中 */
    display: flex;
    justify-content: center;
    align-items: center;
    /* 可选：添加一些内边距 */
    padding: 0 16rpx;
    /* 禁止按钮文本换行 */
    white-space: nowrap;
  }
  
  /* 与题目区域的衔接效果 */
  .question-list-container {
    padding-top: 8rpx; /* 保持与搜索栏的呼吸感 */
  }
/* 题目容器基础样式 */
/* 重置默认间距 */
page {
    padding: 0;
    margin: 0;
  }
  
  /* 题目列表容器 */
  .question-list-container {
    padding: 20rpx 24rpx;
  }
  
  /* 题目项优化版 */
  .question-item {
    margin-bottom: 24rpx; /* 只保留底部间距 */
    padding: 28rpx;
    background: #ffffff;
    border-radius: 12rpx;
    box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
  }
  
  /* 题目头部紧凑布局 */
  .question-header {
    margin-bottom: 20rpx;
    line-height: 1.4; /* 调整行高 */
  }
  
  /* 其他原有样式保持不变... */
  
  .q-id {
    font-weight: bold;
    color: #1677ff;
    margin-right: 10rpx;
  }
  
  /* 选项容器布局 */
  .options-container {
    display: flex;
    flex-direction: column;
    gap: 16rpx;
  }
  
  /* 基础选项样式 */
  .option-item {
    padding: 20rpx 24rpx;
    margin-bottom: 10rpx;
    border-radius: 8rpx;
    background: #f5f5f5;
    border: 1px solid #eee;
  }
  
  /* 选项文字样式 */
  .option-text {
    font-size: 28rpx;
    color: #666;
  }
  
   /* 选中状态 - 极简版 */
.option-selected {
    background: #1890ff;
    border-color: #1890ff;
  }
  
  .option-selected .option-text {
    color: white;
  }
  /* 无内容显示修饰 */
  .empty-tip {
    display: flex;
    justify-content: center;
    align-items: center;
    height: 60vh; /* 占据屏幕60%高度确保垂直居中 */
    text-align: center;
  }
  
  .empty-text {
    color: #999999; /* 灰色字体 */
    font-size: 16px; /* 标准字号 */
    line-height: 1.5;
  }
  /* 判断题样式 */
.judge-question .radio-group {
    display: flex;
    margin-top: 16px;
  }
  
  .radio-option {
    display: flex;
    align-items: center;
    margin-right: 32px;
  }
  
  /* 基础未选中样式保持不变 */
.custom-radio {
    width: 20px;
    height: 20px;
    border: 2px solid #1890ff;
    border-radius: 50%;
    margin-right: 10px;
    position: relative;
    transition: all 0.3s ease;
  }
  
  /* 选中状态 - 优雅动画效果 */
  .custom-radio.checked {
    background-color: #1890ff;
    box-shadow: 0 0 0 2px rgba(24, 144, 255, 0.2);
  }
  
  /* 使用纯CSS实现对勾动画 */
  .custom-radio.checked::after {
    content: "";
    position: absolute;
    left: 6px;
    top: 2px;
    width: 5px;
    height: 10px;
    border: solid white;
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
    animation: checkPop 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }
  
  @keyframes checkPop {
    0% { transform: rotate(45deg) scale(0); }
    80% { transform: rotate(45deg) scale(1.2); }
    100% { transform: rotate(45deg) scale(1); }
  }
  /* 判断结果样式 */
.result-feedback {
    display: flex;
    align-items: center;
    padding: 12px 16px;
    margin: 10px 0;
    border-radius: 8px;
    background-color: #fff;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    animation: fadeIn 0.3s;
  }
  
  /* 正确状态 */
  .correct {
    border-left: 4px solid #52c41a;
  }
  .correct .feedback-icon {
    color: #52c41a;
    font-weight: bold;
  }
  .correct .feedback-text {
    color: #52c41a;
  }
  
  /* 错误状态 */
  .error {
    border-left: 4px solid #f5222d;
  }
  .error .feedback-icon {
    color: #f5222d;
    font-weight: bold;
  }
  .error .feedback-text {
    color: #f5222d;
  }
  
  /* 图标样式 */
  .feedback-icon {
    font-size: 18px;
    margin-right: 8px;
    width: 20px;
    text-align: center;
  }
  
  /* 文字样式 */
  .feedback-text {
    text-align: center;
    font-size: 15px;
    font-weight: 500;
  }
  
  /* 入场动画 */
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(5px); }
    to { opacity: 1; transform: translateY(0); }
  }
  /* 选择题提交样式 */
  .submit-container {
    text-align: center;
    margin-top: 20px;
  }
  
  .submit-btn {
    background-color: #1E90FF;
    color: #fff;
    padding: 10px 20px;
    border-radius: 5px;
  }
  
  .option-item {
    padding: 10px;
    cursor: pointer;
  }
  
  
 /* styles.wxss */
.page-container {
    display: flex;
    justify-content: center; /* 水平居中 */
    align-items: center; /* 垂直居中 */
  }
  
  .correct-answer, .wrong-answer {
    padding: 10px;
    border-radius: 4px;
    font-size: 14px;
    line-height: 1.2;
    display: inline-block; /* 确保文本块在一行内显示 */
    border: 1px solid #ddd; /* 使用浅灰色边框 */
    text-align: center; /* 文本水平居中 */
  }
  
  .correct-answer {
    color: #28a745; /* 保持绿色文字 */
  }
  
  .wrong-answer {
    color: #dc3545; /* 保持红色文字 */
  }