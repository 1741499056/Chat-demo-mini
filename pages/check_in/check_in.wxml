<view class="page-bg">
  <image class="bg-img" src="https://newlan.oss-cn-shanghai.aliyuncs.com/v1%E5%8A%9F%E8%83%BD%E8%BD%AE%E6%92%AD%E5%9B%BE/ui/check_in_bg.jpg" mode="aspectFill"></image>
</view>

<!-- 打卡日历 -->
<view class="calendar-section">
  <!-- 顶部触发条 -->
  <view class="calendar-toggle-bar" bindtap="toggleCalendar">
    <view class="toggle-content">
      <text class="toggle-text">已连续打卡 <text class="highlight-num">{{consecutiveDays}}</text> 天 🔥 继续加油！</text>
    </view>
    <!-- 箭头图标，根据状态旋转 -->
    <view class="arrow-icon {{isCalendarExpanded ? 'rotate' : ''}}"></view>
  </view>

  <!-- 日历主体（动画容器） -->
  <view class="calendar-body {{isCalendarExpanded ? 'expanded' : ''}}">
    <view class="calendar-inner">
      <!-- 月份切换/显示 -->
      <view class="calendar-header">
        <view class="month-title">{{currentYear}}年 {{currentMonth}}月</view>
      </view>

      <!-- 星期表头 -->
      <view class="week-row">
        <text wx:for="{{['日','一','二','三','四','五','六']}}" wx:key="*this">{{item}}</text>
      </view>

      <!-- 日期网格 -->
      <view class="days-grid">
        <block wx:for="{{calendarDays}}" wx:key="fullDate">
          <!-- 空白占位格 -->
          <view wx:if="{{item.isEmpty}}" class="day-cell empty"></view>
          
          <!-- 有日期的格子 -->
          <view wx:else class="day-cell {{item.isToday ? 'today' : ''}}">
            <view class="day-circle {{item.isSigned ? 'signed' : ''}}">
              <text>{{item.day}}</text>
            </view>
            <!-- 打卡成功的小标记 -->
            <view wx:if="{{item.isSigned}}" class="signed-dot"></view>
          </view>
        </block>
      </view>
    </view>
  </view>
</view>

<scroll-view class="scroller" scroll-y="true">
  <view class="content-wrapper">
    
    <!-- <view class="stats-container">
      <view class="stat-box">
        <text class="stat-num">{{consecutiveDays}}</text>
