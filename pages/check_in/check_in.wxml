      </view>
      <view class="stat-divider"></view>
      <view class="stat-box">
        <text class="stat-num">{{totalDays}}</text>
        <text class="stat-label">总共打卡(天)</text>
      </view>
    </view> -->

    <view class="completed-card" wx:if="{{isCompleted}}">
      <view class="success-icon"></view>
      <text class="completed-title">今日打卡已完成</text>
      <text class="completed-desc">温故而知新，明天请继续努力哦！</text>
    </view>

    <view class="poem-card" wx:if="{{!isCompleted && currentPoem}}">
      <view class="poem-header">
        <view class="header-line"></view>
        <text class="header-title">今日背诵</text>
        <view class="header-line"></view>
      </view>
      
      <view class="poem-content">
        <text class="poem-title">{{currentPoem.title}}</text>
        <text class="poem-author">[{{currentPoem.dynasty}}] {{currentPoem.author}}</text>
        <rich-text class="poem-body" nodes="{{currentPoem.content}}"></rich-text>
      </view>
    </view>

    <view class="action-group" wx:if="{{!isCompleted && currentPoem}}">
      <button class="btn btn-secondary" bindtap="onAlreadyKnown">我已会背</button>
      <button class="btn btn-primary" bindtap="onRecite">开始背诵</button>
    </view>

