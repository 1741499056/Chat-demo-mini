<view class="container">
  <image class="background-image" src="/images/980.jpg" mode="aspectFill"></image>
<!-- 头部Logo -->
<view class="header">
  
  <text class="app-name">{{title}}</text>
</view>

<!-- 登录表单 -->
<view class="form-container">
  <!-- 切换登录方式 -->
  <view class="login-type-tabs">
    <text class="{{activeType === 'phone' ? 'active' : ''}}" bindtap="switchLoginType" data-type="phone">手机号/用户名登录</text>
    <text class="{{activeType === 'code' ? 'active' : ''}}" bindtap="switchLoginType" data-type="code">注册</text>
  </view>

  <!-- 手机号登录表单 -->
  <view class="{{activeType === 'phone' ? 'show' : 'hide'}}">
    <view class="input-group">
      <text class="label">手机/用户名号</text>
      <input type="number" placeholder="请输入手机号/用户名" bindinput="onPhoneInput" />
    </view>
    <view class="input-group">
      <text class="label">密码</text>
      <input password placeholder="请输入密码" bindinput="onPasswordInput" />
    </view>
    <view class="forgot-password">
      <text bindtap="navigateToForgotPassword">忘记密码？</text>
    </view>
  </view>

  <!-- 验证码登录表单 -->
  <view class="{{activeType === 'code' ? 'show' : 'hide'}}">
    <view class="input-group">
      <text class="label">手机号</text>
      <input type="string" placeholder="请输入用户名" bindinput="onUsernameInput" />
    </view>
    <view class="input-group">
      <text class="label">输入密码</text>
      <input type="string" placeholder="请输入密码" bindinput="onPasswordInput" />
    </view>
    <!-- <view class="input-group">
      <text class="label">确认密码</text>
      <input type="string" placeholder="请确认密码" bindinput="onPasswordInput" />
    </view> -->
    <!-- <view class="input-group code-group">
      <text class="label">验证码</text>
      <input type="number" placeholder="请输入验证码" bindinput="onCodeInput" />
      <button class="get-code-btn" disabled="{{!canGetCode}}" bindtap="getVerificationCode">
        {{countdown > 0 ? countdown + 's后重发' : '获取验证码'}}
      </button>
    </view> -->
  </view>

  <!-- "{{activeType === 'phone' ? 'show' : 'hide'}}" -->
  <!-- "login-btn" -->
  <!-- 登录按钮 disabled="{{!canLogin}}"-->
  <button class="{{activeType === 'phone' ? 'login-btn' : 'hide'}}"  bindtap="login">登录</button>
  <!-- 注册按钮 -->
  <button class="{{activeType !== 'phone' ? 'register-btn' : 'hide'}}"  bindtap="register">注册</button>

  <!-- 其他登录方式 -->
  <view class="other-login-methods">
    <text class="divider">其他登录方式</text>
    <view class="social-buttons">
      <button class="social-btn" bindtap="loginWithWechat">
        <image src="/images/微信.jpg" mode="aspectFit"></image>
      </button>
      <button class="social-btn" bindtap="loginWithQQ">
        <image src="/images/QQ.png" mode="aspectFit"></image>
      </button>
    </view>
  </view>
</view>

<!-- 底部 -->
<view class="footer">
  <text bindtap="getDailyPoem">获取每日一诗</text>
  <text class="divider-line">|</text>
  <text bindtap="navigateToRegister">注册账号</text>
  <text class="divider-line">|</text>
  <text bindtap="navigateToPrivacy">隐私政策</text>
</view>
</view>  

